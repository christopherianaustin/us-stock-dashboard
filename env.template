# Template for your settings file.
# Copy this file to ".env" (your private copy) and ".env.example" (shared template),
# then fill in your own values in ".env" only.

# SEC requires a real contact (company/app name + email) on every request.
SEC_USER_AGENT="CompanyName DemoApp contact@example.com"
# Free key from https://finnhub.io (Dashboard). Leave empty to skip Finnhub.
FINNHUB_API_KEY=""
# Where prices come from: "yfinance" (demo) or "nanovest" (later)
PRICE_PROVIDER="yfinance"
# true = hide every DEMO_ONLY field (shows what a licensed-only app looks like)
PRODUCTION_SAFE_MODE="false"
# en (English) or id (Bahasa Indonesia)
LANGUAGE="en"
